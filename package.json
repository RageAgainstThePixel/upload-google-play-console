{
  "name": "upload-google-play-console",
  "version": "2.0.0",
  "description": "A Github action to upload abb/apk and build metadata artifacts to the Google Play Console",
  "author": "RageAgainstThePixel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RageAgainstThePixel/upload-google-play-console.git"
  },
  "bugs": {
    "url": "https://github.com/RageAgainstThePixel/upload-google-play-console/issues"
  },
  "homepage": "https://github.com/RageAgainstThePixel/upload-google-play-console",
  "main": "dist/index.js",
  "keywords": [],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/glob": "^0.7.0",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "@googleapis/androidpublisher": "^42.2.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@vercel/ncc": "^0.45.0",
    "jest": "^30.5.2",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "tests": "jest --roots tests",
    "build": "npm run clean && npm run bundle",
    "bundle": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "clean": "npm install && shx rm -rf dist/ out/ node_modules/ && npm ci"
